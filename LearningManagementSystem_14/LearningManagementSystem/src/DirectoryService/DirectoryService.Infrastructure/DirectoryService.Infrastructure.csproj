<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- ORM (Entity Framework Core) - позволяет работать с базой данных при помощи объектов -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.9" />
    <!-- Расширение для конфигурирования моделей и создания миграций -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Провайдер Entity Framework Core для работы с PostgreSQL -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <!-- IOptions<T> для биндинга PostgreSqlConnectionOptions из конфигурации (задача 11) -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.9" />
    <!-- Нужны LmsDbContextFactory (design-time фабрика для dotnet ef) для чтения appsettings.json -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DirectoryService.UseCases\DirectoryService.UseCases.csproj" />
  </ItemGroup>

  <!-- Задача 13: глобальный using для Result-паттерна. -->
  <ItemGroup>
    <Using Include="Domain.Common" />
    <Using Include="Domain.Common.Result" Static="true" />
  </ItemGroup>

</Project>
